# Imagen GHCR — copiar a .env.prod en VPS
# chmod 600 .env.prod

GHCR_OWNER=lelion13
IMAGE_TAG=sha-reemplazar-tras-primer-build
WEB_HOST=habitacion.lionapp.cloud

# App
NODE_ENV=production
JWT_SECRET=generar-secreto-largo-aleatorio
NEXT_PUBLIC_APP_URL=https://habitacion.lionapp.cloud

# MongoDB (servicio compose "mongodb")
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=app_habitacion
MONGO_INITDB_ROOT_USERNAME=habitacion
MONGO_INITDB_ROOT_PASSWORD=generar-password-mongo

# Habitación: vacío en prod — tablets usan /habitacion?key=room-XXX
NEXT_PUBLIC_ROOM_KEY=

# Bootstrap inicial (solo primer deploy; quitar después)
BOOTSTRAP_ENABLED=false

# TZ opcional
TZ=America/Argentina/Buenos_Aires
